# Deny by default: only image build inputs may enter the Docker context.
**
!go.mod
!go.sum
!api/**/*.go
!api/openapi.yaml
!cmd/**/*.go
!internal/**/*.go

# Only the Admin image needs Console source; Go stages copy their own inputs.
!web/
web/*
!web/package.json
!web/package-lock.json
!web/tsconfig.json
!web/vite.config.ts
!web/index.html
!web/src/
!web/src/**

# Vite publishes public files verbatim. Add each new shipped file explicitly.
!web/public/ai/orbitjob-workloads/SKILL.md
!web/public/ai/orbitjob-workloads/assets/manual-job.yaml
!web/public/ai/orbitjob-workloads/assets/manual-workflow.yaml
!web/public/ai/orbitjob-workloads/orbitjob-workloads.zip
!web/public/ai/orbitjob-workloads/references/api-index.md
!web/public/ai/orbitjob-workloads/references/docs/concepts/execution-model.md
!web/public/ai/orbitjob-workloads/references/docs/getting-started.md
!web/public/ai/orbitjob-workloads/references/docs/reference/access-policies.md
!web/public/ai/orbitjob-workloads/references/docs/reference/http-conventions.md
!web/public/ai/orbitjob-workloads/references/docs/reference/workload-resources.md
!web/public/ai/orbitjob-workloads/references/docs/tasks/call-api.md
!web/public/ai/orbitjob-workloads/references/docs/tasks/cancel-a-run.md
!web/public/ai/orbitjob-workloads/references/docs/tasks/checks-and-slos.md
!web/public/ai/orbitjob-workloads/references/docs/tasks/functions-and-workflows.md
!web/public/ai/orbitjob-workloads/references/docs/tasks/manage-access.md
!web/public/ai/orbitjob-workloads/references/docs/tasks/manage-jobs.md
!web/public/ai/orbitjob-workloads/references/docs/tasks/read-logs.md
!web/public/ai/orbitjob-workloads/references/docs/tasks/trigger-and-observe.md
!web/public/ai/orbitjob-workloads/references/openapi.yaml
!web/public/ai/orbitjob-workloads/references/scheduledjob-crd.yaml
!web/public/ai/orbitjob-workloads/references/usage.md
!web/public/ai/orbitjob-workloads/references/workflowjob-crd.yaml
!web/public/ai/orbitjob-workloads/sources.json
!web/public/orbit.svg

# Tests, local credentials and generated tooling output are never image inputs.
**/*_test.go
**/*.test.ts
**/*.test.tsx
**/testdata
**/node_modules
**/__pycache__
**/*.py[cod]
**/*.o
**/.runtime
**/.env
**/.env.*
**/*.key
**/*.tsbuildinfo
**/.DS_Store
