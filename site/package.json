{
  "name": "orbitjob-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "prepare:content": "node scripts/prepare-content.mjs",
    "dev": "npm run prepare:content && astro dev --host 127.0.0.1",
    "build": "npm test && npm run prepare:content && astro build && node scripts/assemble.mjs && node scripts/check.mjs",
    "test": "node --test scripts/*.test.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "check": "node scripts/check.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.10",
    "@astrojs/starlight": "0.42.7",
    "@fontsource/geist": "5.3.0",
    "@scalar/api-reference": "1.76.0",
    "astro": "7.4.12",
    "github-slugger": "2.0.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0"
  }
}
