---
import '../styles/site.css';
import '@fontsource/geist/latin-400.css';
import '@fontsource/geist/latin-500.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>404 | OrbitJob</title>
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#recovery"><span lang="en">Skip to content</span> / <span lang="zh-CN">跳转到正文</span></a>
    <header class="site-header">
      <a class="wordmark" href={`${base}/`} lang="en">OrbitJob</a>
      <nav aria-label="Documentation languages" lang="en">
        <a href="#recovery-en" lang="en">English</a>
        <a href="#recovery-zh" lang="zh-CN">简体中文</a>
      </nav>
    </header>
    <main id="recovery" class="not-found">
      <h1><span lang="en">Page not found</span><span lang="zh-CN">页面未找到</span></h1>
      <div data-recovery-sections>
        <section id="recovery-en" lang="en" aria-labelledby="recovery-en-title">
          <h2 id="recovery-en-title">English documentation</h2>
          <p>This address does not match a published page. Check the URL, or continue from the documentation home or a topic index.</p>
          <ul>
            <li><a href={`${base}/`}>Open documentation home</a></li>
            <li><a href={`${base}/docs/getting-started/`}>Browse getting started</a></li>
            <li><a href={`${base}/docs/reference/`}>Browse references</a></li>
          </ul>
        </section>
        <section id="recovery-zh" lang="zh-CN" aria-labelledby="recovery-zh-title">
          <h2 id="recovery-zh-title">简体中文文档</h2>
          <p>此网址没有对应的已发布页面。请检查网址，或从文档首页和主题目录继续浏览。</p>
          <ul>
            <li><a href={`${base}/zh-cn/`}>打开中文文档首页</a></li>
            <li><a href={`${base}/zh-cn/docs/getting-started/`}>浏览入门指南</a></li>
            <li><a href={`${base}/zh-cn/docs/reference/`}>浏览参考资料</a></li>
          </ul>
        </section>
      </div>
    </main>
    <script>
      const base = import.meta.env.BASE_URL.replace(/\/$/, '');
      // Only the pathname selects a language. Recovery links never reuse input.
      const relative = window.location.pathname.startsWith(`${base}/`)
        ? window.location.pathname.slice(base.length) : '';
      const chinese = /^\/zh-cn(?:\/|$)/.test(relative);
      document.documentElement.lang = chinese ? 'zh-CN' : 'en';
      document.title = `${chinese ? '页面未找到' : 'Page not found'} | OrbitJob`;
      if (chinese) {
        const sections = document.querySelector('[data-recovery-sections]');
        const chineseSection = document.getElementById('recovery-zh');
        if (sections && chineseSection) sections.prepend(chineseSection);
        const title = document.querySelector('h1');
        const chineseTitle = title?.querySelector('[lang="zh-CN"]');
        if (title && chineseTitle) title.prepend(chineseTitle);
      }
    </script>
  </body>
</html>

<style>
  .not-found { max-width: 72ch; margin: 3rem auto; padding-inline: 30px; }
  h1 { display: grid; gap: .5rem; margin-block: 0 2.5rem; font-size: clamp(1.8rem, 4vw, 2.3rem); line-height: 1.3; font-weight: 500; letter-spacing: -.03em; }
  section + section { border-top: 1px solid var(--line); margin-top: 2rem; padding-top: 2rem; }
  h2 { margin-block: 0 .75rem; font-size: 1.25rem; font-weight: 500; }
  p { margin-block: 0 1rem; color: var(--muted); }
  ul { padding-inline-start: 1.25rem; margin: 0; }
  li + li { margin-top: .5rem; }
  @media (max-width: 700px) { .not-found { margin-block: 2rem; padding-inline: 20px; } }
</style>
