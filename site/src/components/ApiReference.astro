---
import Header from '../components/Header.astro';
import catalogEn from '../generated/catalog.json';
import catalogZh from '../generated/catalog.zh-cn.json';
import { uiLocale } from '../i18n';
import '../styles/site.css';
import '@fontsource/geist/latin-400.css';
import '@fontsource/geist/latin-500.css';
const { base, zh, lang, prefix, link, t } = uiLocale(Astro.url.pathname);
const catalog = zh ? catalogZh : catalogEn;
const tagSlug = (tag: string) => tag.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const tags = [...new Set(catalog.operations.map((operation) => operation.tag))];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data: blob:; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta name="description" content={t("Read OrbitJob's complete HTTP API, inspect schemas and copy requests. The reference renders the installation's OpenAPI contract locally.", '查看 OrbitJob 的完整 HTTP API、数据结构与请求示例。参考页面在本地渲染契约，不向后端发送请求。')} />
    <title>{t('Rich HTTP API reference — OrbitJob', 'HTTP API 浏览器 — OrbitJob')}</title>
  </head>
  <body class="api-shell">
    <a class="skip" href="#api-content">{t('Skip to API reference', '跳至 API 参考')}</a>
    <Header />
    <main id="api-content">
      <section class="api-intro" aria-labelledby="reference-title">
        <h1 id="reference-title">{t('HTTP API reference', 'HTTP API 参考')}</h1>
        <p>{t(`${catalog.operations.length} operations from the service’s OpenAPI contract. Inspect schemas and copy a request into your own client. API calls run against your installation; this reference does not execute requests or collect credentials.`, `${catalog.operations.length} 个接口，来自服务端的 OpenAPI 契约。查看 schema 并将请求复制到自己的客户端。调用应发往自己的部署；本站不执行请求，也不收集凭据。`)}</p>
        <ul class="reference-links">
          <li><a href={link('docs/tasks/call-api')}>{t('Authentication and calling examples', '认证方式与调用示例')}</a></li>
          <li><a href={link('docs/reference/http')}>{t('Searchable API documentation', '可搜索的 API 文档')}</a></li>
          <li><a href={`${base}/openapi.json`} download="orbitjob-openapi.json">{t('Download OpenAPI JSON', '下载原始 OpenAPI JSON')}</a></li>
        </ul>
      </section>

      <details class="operation-index">
        <summary>{t('Operation directory', '接口目录')} ({catalog.operations.length})</summary>
        <p>{t('Choose an operation to open its schemas and code samples below, or follow its documentation link for parameters, responses and authorization details.', '选择接口，在下方查看 schema 与代码示例；也可打开对应文档，查看参数、响应和授权要求。')}</p>
        <div class="operation-filters" hidden>
          <div><label for="operation-search">{t('Find an operation', '查找接口')}</label><input type="search" id="operation-search" placeholder={t('Path, name or permission', '路径、名称或权限')} autocomplete="off" /></div>
          <div><label for="operation-method">{t('HTTP method', 'HTTP 方法')}</label><select id="operation-method"><option value="">{t('All methods', '全部方法')}</option>{[...new Set(catalog.operations.map((operation) => operation.method))].map((method) => <option value={method}>{method.toUpperCase()}</option>)}</select></div>
        </div>
        <p id="operation-count" class="operation-count" role="status" aria-live="polite">{t(`${catalog.operations.length} operations`, `${catalog.operations.length} 个接口`)}</p>
        {tags.map((tag) => <section class="operation-group" aria-labelledby={`directory-${tagSlug(tag)}`}>
          <h2 id={`directory-${tagSlug(tag)}`}>{catalog.operations.find(operation => operation.tag === tag)?.tagLabel || tag}</h2>
          <ul>{catalog.operations.filter((operation) => operation.tag === tag).map((operation) => <li data-operation data-method={operation.method}>
            <div class="operation-name"><span class="method">{operation.method.toUpperCase()}</span><a href={`#tag/${tagSlug(tag)}/${operation.id}`}><code>{operation.path}</code></a></div>
            <p>{operation.summary || operation.id}</p>
            <div class="operation-meta"><span>{operation.permission ? <><span>{t('Permission: ', '所需权限：')}</span><code>{operation.permission}</code></> : operation.authenticated ? t('Authentication required', '需要认证') : t('Public endpoint', '公开接口')}</span><a href={link(`docs/reference/http/operations/${operation.id.toLowerCase()}`)}>{t('Documentation', '接口文档')}<span class="sr-only">{t(' for ', '：')}{operation.id}</span></a></div>
          </li>)}</ul>
        </section>)}
      </details>

      <div id="api-load-status" class="api-load-status" role="status">{t('Loading the local schema viewer…', '正在加载本地 API 浏览器…')}</div>
      <noscript><p class="api-load-status">{t('The rich schema viewer needs JavaScript. Use the', 'API 浏览器需要 JavaScript。请打开')} <a href={link('docs/reference/http')}>{t('complete API documentation', '完整 API 文档')}</a> {t('to read every operation and schema.', '查看全部接口与 schema。')}</p></noscript>
      <div id="api-reference" data-spec={`${prefix}/openapi.json`} data-locale={lang}></div>
    </main>
    <script>
      import { createApiReference } from '@scalar/api-reference';
      import '@scalar/api-reference/style.css';
      const root = document.querySelector<HTMLElement>('#api-reference')!;
      const zh = root.dataset.locale === 'zh-CN';
      const status = document.querySelector<HTMLElement>('#api-load-status')!;
      const search = document.querySelector<HTMLInputElement>('#operation-search')!;
      const method = document.querySelector<HTMLSelectElement>('#operation-method')!;
      const operations = [...document.querySelectorAll<HTMLElement>('[data-operation]')];
      const count = document.querySelector<HTMLElement>('#operation-count')!;
      document.querySelector<HTMLElement>('.operation-filters')!.hidden = false;
      function filterOperations() {
        const query = search.value.trim().toLocaleLowerCase();
        let visible = 0;
        for (const operation of operations) {
          const matches = (!method.value || operation.dataset.method === method.value) && (operation.textContent || '').toLocaleLowerCase().includes(query);
          operation.hidden = !matches;
          visible += Number(matches);
        }
        document.querySelectorAll<HTMLElement>('.operation-group').forEach((group) => {
          group.hidden = !group.querySelector('[data-operation]:not([hidden])');
        });
        count.textContent = visible
          ? zh ? `显示 ${visible} / ${operations.length} 个接口` : `${visible} of ${operations.length} operations`
          : zh ? '没有匹配的接口。请清空搜索，或选择其他 HTTP 方法。' : 'No matching operations. Clear the search or choose another method.';
      }
      search.addEventListener('input', filterOperations);
      method.addEventListener('change', filterOperations);
      // Fetch only the bundled contract. Request execution and credential entry
      // are disabled in the viewer; the CSP also limits connections to this site.
      try {
        const response = await fetch(root.dataset.spec!, { credentials: 'omit' });
        if (!response.ok) throw new Error(`OpenAPI request returned ${response.status}`);
        const content = await response.json();
        createApiReference(root, {
          content,
          localization: { locale: zh ? 'zh-CN' : 'en' },
          theme: 'default',
          hideClientButton: true,
          hideTestRequestButton: true,
          showDeveloperTools: 'never',
          showOperationId: true,
          showExtensions: ['x-orbitjob-permission'],
          withDefaultFonts: false,
          documentDownloadType: zh ? 'none' : 'json',
          persistAuth: false,
          telemetry: false,
          agent: { disabled: true },
          mcp: { disabled: true },
          proxyUrl: '',
          generateTagSlug: ({ name = 'Service' }) => name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, ''),
          generateOperationSlug: ({ operationId, method, path }) => operationId || `${method}${path}`,
          servers: [{ url: 'http://localhost:18080', description: zh ? '本地 Kind 端口转发；请替换为自己的部署地址' : 'Local Kind port-forward; replace with your installation origin' }],
        });
        status.hidden = true;
      } catch (error) {
        status.textContent = zh
          ? 'API 浏览器加载失败。请通过上方链接查看完整 API 文档，或下载原始 OpenAPI JSON。'
          : 'The schema viewer could not load. Use the complete API documentation or download the OpenAPI JSON from the links above.';
        status.setAttribute('role', 'alert');
        console.error('OrbitJob API reference could not initialize:', error);
      }
    </script>
  </body>
</html>
