  {
    "name": "db-vacuum-analyze",
    "trigger_type": "cron",
    "cron_expr": "0 3 * * 0",
    "handler_type": "exec",
    "handler_payload": {
      "command": "psql",
      "args": [
        "-h",
        "db-primary.internal",
        "-U",
        "admin",
        "-c",
        "VACUUM ANALYZE"
      ]
    },
    "timeout_sec": 1800,
    "retry_limit": 0,
    "concurrency_policy": "forbid",
    "misfire_policy": "skip"
  },
  {
    "name": "db-reindex-weekly",
    "trigger_type": "cron",
    "cron_expr": "0 4 * * 0",
    "handler_type": "exec",
    "handler_payload": {
      "command": "psql",
      "args": [
        "-h",
        "db-primary.internal",
        "-U",
        "admin",
        "-c",
        "REINDEX DATABASE current"
      ]
    },
    "timeout_sec": 3600,
    "retry_limit": 0,
    "concurrency_policy": "forbid",
    "misfire_policy": "skip"
  },
  {
    "name": "db-connection-pool-reset",
    "trigger_type": "cron",
    "cron_expr": "0 */6 * * *",
    "handler_type": "exec",
    "handler_payload": {
      "command": "pg_ctl",
      "args": [
        "reload",
        "-D",
        "/var/lib/postgresql/data"
      ]
    },
    "timeout_sec": 60,
    "retry_limit": 1,
    "concurrency_policy": "allow",
    "misfire_policy": "skip"
  },
  {
    "name": "db-slow-query-log-rotate",
    "trigger_type": "cron",
    "cron_expr": "0 1 * * *",
    "handler_type": "exec",
    "handler_payload": {
      "command": "mv",
      "args": [
        "/var/log/pg/slow.log",
        "/var/log/pg/slow.log.1"
      ]
    },
    "timeout_sec": 120,
    "retry_limit": 0,
    "concurrency_policy": "allow",
    "misfire_policy": "skip"
  },
  {
    "name": "cicd-nightly-build",
    "trigger_type": "cron",
    "cron_expr": "0 3 * * *",
    "handler_type": "http",
    "handler_payload": {
      "url": "https://ci.internal/api/v1/pipelines/nightly/trigger",
      "method": "POST",
      "body": "{\"branch\":\"main\",\"suite\":\"full\",\"notify\":[\"#builds\"]}",
      "headers": {
        "Content-Type": "application/json"
      }
    },
    "timeout_sec": 1800,
    "retry_limit": 2,
    "concurrency_policy": "forbid",
    "misfire_policy": "fire_now"
  },
  {
    "name": "cicd-security-scan",
    "trigger_type": "cron",
    "cron_expr": "0 4 * * 0",
    "handler_type": "http",
    "handler_payload": {
      "url": "https://ci.internal/api/v1/security/scan",
      "method": "POST",
      "body": "{\"scope\":\"all_dependencies\",\"fail_on\":\"critical\"}",
      "headers": {
        "Content-Type": "application/json"
      }
    },
    "timeout_sec": 900,
    "retry_limit": 1,
    "concurrency_policy": "forbid",
    "misfire_policy": "fire_now"
  },
  {
    "name": "cicd-dependency-update",
    "trigger_type": "cron",
    "cron_expr": "0 2 * * 1",
    "handler_type": "exec",
    "handler_payload": {
      "command": "pip",
      "args": [
        "install",
        "--upgrade",
        "-r",
        "/app/requirements.txt",
        "--dry-run"
      ]
    },
    "timeout_sec": 1200,
    "retry_limit": 1,
    "concurrency_policy": "forbid",
    "misfire_policy": "skip"
  },
  {
    "name": "manual-emergency-rollback",
    "trigger_type": "manual",
    "handler_type": "exec",
    "handler_payload": {
      "command": "helm",
      "args": [
        "rollback",
        "prod-api",
        "--wait",
        "--timeout",
        "5m"
      ]
    },
    "timeout_sec": 600,
    "retry_limit": 0
  },
  {
    "name": "manual-data-fix",
    "trigger_type": "manual",
    "handler_type": "http",
    "handler_payload": {
      "url": "https://admin.internal/api/v1/data/fix-orphan-records",
      "method": "POST",
      "body": "{\"dry_run\":true,\"batch_size\":1000}",
      "headers": {
        "Content-Type": "application/json"
      }
    },
    "timeout_sec": 300,
    "retry_limit": 0
  }
]
