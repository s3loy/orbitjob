    "timeout_sec": 900,
    "retry_limit": 0,
    "concurrency_policy": "allow",
    "misfire_policy": "skip"
  },
  {
    "name": "cache-warmup-daily",
    "trigger_type": "cron",
    "cron_expr": "30 7 * * 1-5",
    "handler_type": "exec",
    "handler_payload": {
      "command": "redis-cli",
      "args": [
