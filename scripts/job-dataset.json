  {
    "name": "replica-lag-check",
    "trigger_type": "cron",
    "cron_expr": "*/10 * * * *",
    "handler_type": "exec",
    "handler_payload": {
      "command": "psql",
      "args": [
        "-h",
        "db-replica.internal",
        "-U",
        "readonly",
        "-c",
        "SELECT extract(epoch FROM now() - pg_last_xact_replay_timestamp()) AS lag_sec"
      ]
    },
    "timeout_sec": 30,
    "retry_limit": 0,
    "concurrency_policy": "allow",
    "misfire_policy": "skip"
  },
