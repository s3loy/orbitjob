        "cache.internal",
        "--eval",
        "/scripts/warmup.lua"
      ]
    },
    "timeout_sec": 120,
    "retry_limit": 1,
    "concurrency_policy": "forbid",
    "misfire_policy": "fire_now"
  },
  {
    "name": "search-index-rebuild",
    "trigger_type": "cron",
    "cron_expr": "0 1 * * 0",
    "handler_type": "exec",
    "handler_payload": {
      "command": "curl",
      "args": [
        "-X",
        "POST",
        "http://elasticsearch.internal:9200/_reindex",
        "-H",
        "Content-Type: application/json",
        "-d",
        "{\"source\":{\"index\":\"prod\"},\"dest\":{\"index\":\"prod-v2\"}}"
      ]
    },
    "timeout_sec": 1800,
    "retry_limit": 1,
    "concurrency_policy": "forbid",
    "misfire_policy": "skip"
  },
