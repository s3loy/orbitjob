[
  {
    "name": "etl-daily-user-sync",
    "trigger_type": "cron",
    "cron_expr": "0 3 * * *",
    "handler_type": "exec",
    "handler_payload": {
      "command": "psql",
      "args": [
        "-h",
        "db-primary.internal",
        "-U",
        "etl",
        "-c",
        "CALL sync_users()"
      ]
    },
    "timeout_sec": 120,
    "retry_limit": 3,
    "concurrency_policy": "forbid",
    "misfire_policy": "fire_now"
  },
  {
    "name": "etl-hourly-metrics-rollup",
    "trigger_type": "cron",
    "cron_expr": "0 * * * *",
    "handler_type": "exec",
    "handler_payload": {
      "command": "python3",
      "args": [
        "-m",
        "etl.rollup_metrics",
        "--window",
        "1h"
      ]
    },
    "timeout_sec": 60,
    "retry_limit": 2,
    "concurrency_policy": "allow",
    "misfire_policy": "skip"
  },
  {
    "name": "etl-warehouse-export",
    "trigger_type": "cron",
    "cron_expr": "0 6 * * 1-5",
    "handler_type": "webhook",
    "handler_payload": {
      "url": "https://warehouse.internal/api/v1/export",
      "method": "POST",
      "body": "{\"source\":\"prod\",\"tables\":[\"orders\",\"users\",\"sessions\"]}",
      "headers": {
        "Content-Type": "application/json",
        "X-Export-Key": "{{secret:warehouse}}"
      }
    },
    "timeout_sec": 300,
    "retry_limit": 1,
    "concurrency_policy": "forbid",
    "misfire_policy": "fire_now"
  },
  {
    "name": "data-retention-cleanup",
    "trigger_type": "cron",
    "cron_expr": "0 2 * * 0",
    "handler_type": "exec",
    "handler_payload": {
      "command": "find",
      "args": [
        "/data/logs",
        "-name",
        "*.log",
        "-mtime",
        "+90",
        "-delete"
      ]
    },
    "timeout_sec": 600,
    "retry_limit": 0,
    "concurrency_policy": "allow",
    "misfire_policy": "skip"
  },
  {
    "name": "data-partition-create",
    "trigger_type": "cron",
    "cron_expr": "0 0 1 * *",
    "handler_type": "exec",
    "handler_payload": {
      "command": "psql",
      "args": [
        "-h",
        "db-primary.internal",
        "-c",
        "SELECT create_monthly_partitions()"
      ]
    },
    "timeout_sec": 180,
    "retry_limit": 2,
    "concurrency_policy": "forbid",
    "misfire_policy": "fire_now"
  },
  {
    "name": "log-archive-compress",
    "trigger_type": "cron",
    "cron_expr": "0 4 * * 0",
    "handler_type": "exec",
    "handler_payload": {
      "command": "tar",
      "args": [
