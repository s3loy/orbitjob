# OrbitJob local environment template.
# Run `make setup` to generate `.env` and `.runtime/database.env`.
PG_PASSWORD=
ADMIN_BOOTSTRAP_API_KEY=

# Integration tests use a separate PostgreSQL database.
# Change the default password before running tests.
TEST_DATABASE_DSN=postgres://postgres:CHANGE_ME@127.0.0.1:5432/orbitjob_test?sslmode=disable
