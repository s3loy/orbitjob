# OrbitJob local environment template.
# `make docker-up` creates `.env` with random values. Do not copy these
# placeholders into `.env`; use `make env-init` when initialization is needed.
PG_PASSWORD=
MIGRATOR_PASSWORD=
ADMIN_PASSWORD=
RUNTIME_PASSWORD=
OPERATOR_PASSWORD=
GRAFANA_USER=admin
GRAFANA_PASSWORD=
ADMIN_BOOTSTRAP_API_KEY=

# Optional host-side development and integration DSNs.
TEST_DATABASE_DSN=postgres://postgres:password@127.0.0.1:5432/orbitjob_test?sslmode=disable
DATABASE_DSN=postgres://postgres:password@127.0.0.1:5432/orbitjob?sslmode=disable
