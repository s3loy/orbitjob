      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "expr": "sum(rate(orbitjob_executions_total{result=\"failed\"}[5m])) / sum(rate(orbitjob_executions_total[5m]))",
          "legendFormat": "Failure Rate",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Failure Rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
