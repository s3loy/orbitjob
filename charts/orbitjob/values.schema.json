{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["database"],
  "properties": {
    "logs": {
      "type": "object",
      "properties": {
        "collectorPersistence": {
          "type": "object",
          "required": [
            "mode",
            "profile",
            "hostPathBase",
            "quotaVerified",
            "quotaBytes"
          ],
          "additionalProperties": false,
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["hostPath", "ephemeral"]
            },
            "profile": {
              "type": "string",
              "enum": ["development", "production"]
            },
            "hostPathBase": {
              "type": "string",
              "pattern": "^/([A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+$"
            },
            "quotaVerified": {
              "type": "boolean"
            },
            "quotaBytes": {
              "type": "integer",
              "minimum": 67108864
            }
          }
        }
      }
    },
    "database": {
      "type": "object",
      "required": ["secretName", "keys"],
      "properties": {
        "secretName": {
          "type": "string",
          "minLength": 1
        },
        "keys": {
          "type": "object",
          "required": [
            "bootstrapOwner",
            "migrator",
            "admin",
            "runtime",
            "migratorPassword",
            "adminPassword",
            "runtimePassword",
            "bootstrapAPIKey"
          ],
          "properties": {
            "bootstrapOwner": {
              "type": "string",
              "minLength": 1
            },
            "migrator": {
              "type": "string",
              "minLength": 1
            },
            "admin": {
              "type": "string",
              "minLength": 1
            },
            "runtime": {
              "type": "string",
              "minLength": 1
            },
            "migratorPassword": {
              "type": "string",
              "minLength": 1
            },
            "adminPassword": {
              "type": "string",
              "minLength": 1
            },
            "runtimePassword": {
              "type": "string",
              "minLength": 1
            },
            "bootstrapAPIKey": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "executionNetwork": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "profile",
        "enforcementVerified",
        "dnsNamespace",
        "dnsPodLabels",
        "allowedEgress"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "profile": {
          "type": "string",
          "enum": ["development", "production"]
        },
        "enforcementVerified": {
          "type": "boolean"
        },
        "dnsNamespace": {
          "type": "string",
          "minLength": 1
        },
        "dnsPodLabels": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string"
          }
        },
        "allowedEgress": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["namespace", "cidrs", "ports"],
            "properties": {
              "namespace": {
                "type": "string",
                "minLength": 1
              },
              "cidrs": {
                "type": "array",
                "minItems": 1,
                "maxItems": 64,
                "items": {
                  "type": "string",
                  "pattern": "^[0-9A-Fa-f:.]+/[0-9]{1,3}$"
                }
              },
              "ports": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["port", "protocol"],
                  "properties": {
                    "port": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 65535
                    },
                    "protocol": {
                      "type": "string",
                      "enum": ["TCP", "UDP"]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "adminapi": {
      "type": "object",
      "required": ["service", "ingress"],
      "properties": {
        "console": {
          "type": "object",
          "additionalProperties": false,
          "required": ["publicOrigin", "allowInsecureLocalhost"],
          "properties": {
            "publicOrigin": {
              "type": "string",
              "description": "External browser origin without a path. Production sessions require HTTPS; HTTP is limited to explicitly enabled loopback development."
            },
            "allowInsecureLocalhost": {
              "type": "boolean"
            }
          }
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "port", "annotations"],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "nodePort": {
              "type": ["integer", "null"],
              "minimum": 1,
              "maximum": 65535
            },
            "annotations": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "allOf": [
            {
              "if": {
                "required": ["nodePort"],
                "properties": {
                  "nodePort": {
                    "type": "integer"
                  }
                }
              },
              "then": {
                "properties": {
                  "type": {
                    "enum": ["NodePort", "LoadBalancer"]
                  }
                }
              }
            }
          ]
        },
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "className", "host", "annotations", "tls"],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "className": {
              "anyOf": [
                {
                  "const": ""
                },
                {
                  "$ref": "#/definitions/dnsName"
                }
              ]
            },
            "host": {
              "anyOf": [
                {
                  "const": ""
                },
                {
                  "$ref": "#/definitions/ingressHost"
                }
              ]
            },
            "annotations": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "tls": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled", "secretName"],
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "secretName": {
                  "anyOf": [
                    {
                      "const": ""
                    },
                    {
                      "$ref": "#/definitions/dnsName"
                    }
                  ]
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "enabled": {
                        "const": true
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "secretName": {
                        "minLength": 1
                      }
                    }
                  },
                  "else": {
                    "properties": {
                      "secretName": {
                        "maxLength": 0
                      }
                    }
                  }
                }
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "tls": {
                    "properties": {
                      "enabled": {
                        "const": true
                      }
                    }
                  }
                }
              },
              "then": {
                "properties": {
                  "enabled": {
                    "const": true
                  },
                  "host": {
                    "minLength": 1
                  }
                }
              }
            }
          ]
        }
      }
    }
  },
  "definitions": {
    "dnsName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?)*$"
    },
    "ingressHost": {
      "allOf": [
        {
          "$ref": "#/definitions/dnsName"
        },
        {
          "not": {
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$"
          }
        }
      ]
    }
  }
}
