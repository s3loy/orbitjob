{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "database"
  ],
  "properties": {
    "database": {
      "type": "object",
      "required": [
        "secretName",
        "keys"
      ],
      "properties": {
        "secretName": {
          "type": "string",
          "minLength": 1
        },
        "keys": {
          "type": "object",
          "required": [
            "bootstrapOwner",
            "migrator",
            "admin",
            "runtime",
            "migratorPassword",
            "adminPassword",
            "runtimePassword",
            "bootstrapAPIKey"
          ],
          "properties": {
            "bootstrapOwner": {
              "type": "string",
              "minLength": 1
            },
            "migrator": {
              "type": "string",
              "minLength": 1
            },
            "admin": {
              "type": "string",
              "minLength": 1
            },
            "runtime": {
              "type": "string",
              "minLength": 1
            },
            "migratorPassword": {
              "type": "string",
              "minLength": 1
            },
            "adminPassword": {
              "type": "string",
              "minLength": 1
            },
            "runtimePassword": {
              "type": "string",
              "minLength": 1
            },
            "bootstrapAPIKey": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "executionNetwork": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "profile",
        "enforcementVerified",
        "dnsNamespace",
        "dnsPodLabels",
        "allowedEgress"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "profile": {
          "type": "string",
          "enum": [
            "development",
            "production"
          ]
        },
        "enforcementVerified": {
          "type": "boolean"
        },
        "dnsNamespace": {
          "type": "string",
          "minLength": 1
        },
        "dnsPodLabels": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string"
          }
        },
        "allowedEgress": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "namespace",
              "cidrs",
              "ports"
            ],
            "properties": {
              "namespace": {
                "type": "string",
                "minLength": 1
              },
              "cidrs": {
                "type": "array",
                "minItems": 1,
                "maxItems": 64,
                "items": {
                  "type": "string",
                  "pattern": "^[0-9A-Fa-f:.]+/[0-9]{1,3}$"
                }
              },
              "ports": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "port",
                    "protocol"
                  ],
                  "properties": {
                    "port": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 65535
                    },
                    "protocol": {
                      "type": "string",
                      "enum": [
                        "TCP",
                        "UDP"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "adminapi": {
      "type": "object",
      "properties": {
        "console": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "publicOrigin",
            "allowInsecureLocalhost"
          ],
          "properties": {
            "publicOrigin": {
              "type": "string",
              "description": "External browser origin without a path. Production sessions require HTTPS; HTTP is limited to explicitly enabled loopback development."
            },
            "allowInsecureLocalhost": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
