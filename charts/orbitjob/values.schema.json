{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["database"],
  "properties": {
    "database": {
      "type": "object",
      "required": ["secretName", "keys", "passwords", "bootstrapAPIKey"],
      "properties": {
        "secretName": {"type": "string", "minLength": 1},
        "bootstrapAPIKey": {"type": "string", "minLength": 1},
        "keys": {
          "type": "object",
          "required": ["bootstrapOwner", "migrator", "admin", "runtime"],
          "properties": {
            "bootstrapOwner": {"type": "string", "minLength": 1},
            "migrator": {"type": "string", "minLength": 1},
            "admin": {"type": "string", "minLength": 1},
            "runtime": {"type": "string", "minLength": 1}
          }
        },
        "passwords": {
          "type": "object",
          "required": ["migrator", "admin", "runtime", "operator"],
          "properties": {
            "migrator": {"type": "string", "minLength": 1},
            "admin": {"type": "string", "minLength": 1},
            "runtime": {"type": "string", "minLength": 1},
            "operator": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
