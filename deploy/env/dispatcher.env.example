# Dispatcher environment configuration
# Copy to /opt/orbitjob/etc/dispatcher.env and adjust values

# Deployment environment: production | staging | development
APP_ENV=production

# Database connection (PostgreSQL)
DISPATCHER_DSN=postgres://orbitjob:<YOUR_PASSWORD>@127.0.0.1:5432/orbitjob?sslmode=disable

# Fallback DSN (used when DISPATCHER_DSN is not set)
# DATABASE_DSN=postgres://orbitjob:<YOUR_PASSWORD>@127.0.0.1:5432/orbitjob?sslmode=disable

# Tenant ID to dispatch for (empty = auto-detect all active tenants)
# DISPATCHER_TENANT_ID=default

# Number of pending instances to claim per tick, per tenant (default: 50)
# DISPATCHER_BATCH_SIZE=50

# Interval between ticks in seconds (default: 2)
# DISPATCHER_TICK_INTERVAL_SEC=2

# Lease duration for claimed instances in seconds (default: 30)
# DISPATCHER_LEASE_DURATION_SEC=30

# Health check HTTP port (default: 6061)
# Endpoints: /healthz, /readyz
# DISPATCHER_HEALTH_PORT=6061
