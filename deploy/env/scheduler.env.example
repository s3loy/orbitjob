# Scheduler environment configuration
# Copy to /opt/orbitjob/etc/scheduler.env and adjust values

# Deployment environment: production | staging | development
APP_ENV=production

# Shared runtime connection generated once for this installation.
# See docs/database-setup.md.
RUNTIME_DSN=postgres://orbitjob_runtime:<RUNTIME_PASSWORD>@127.0.0.1:5432/orbitjob?sslmode=disable

# Legacy component-specific fallback.
# SCHEDULER_DSN=

# Health check HTTP port (default: 6060)
# Endpoints: /healthz, /readyz
# SCHEDULER_HEALTH_PORT=6060
