# Scheduler environment configuration
# Copy to /opt/orbitjob/etc/scheduler.env and adjust values

# Deployment environment: production | staging | development
APP_ENV=production

# Database connection (PostgreSQL)
SCHEDULER_DSN=postgres://orbitjob:<YOUR_PASSWORD>@127.0.0.1:5432/orbitjob?sslmode=disable

# Fallback DSN (used when SCHEDULER_DSN is not set)
# DATABASE_DSN=postgres://orbitjob:<YOUR_PASSWORD>@127.0.0.1:5432/orbitjob?sslmode=disable

# Number of due jobs to create instances for per tick (default: 100)
# SCHEDULER_BATCH_SIZE=100

# Interval between ticks in seconds (default: 5)
# SCHEDULER_TICK_INTERVAL_SEC=5

# Health check HTTP port (default: 6060)
# Endpoints: /healthz, /readyz
# SCHEDULER_HEALTH_PORT=6060
