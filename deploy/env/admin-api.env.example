# Admin API environment configuration
# Copy to /opt/orbitjob/etc/admin-api.env and adjust values

# Deployment environment: production | staging | development
APP_ENV=production

# Database connection (PostgreSQL)
# Role-specific DSN takes priority over DATABASE_DSN
ADMIN_DSN=postgres://orbitjob:<YOUR_PASSWORD>@127.0.0.1:5432/orbitjob?sslmode=disable

# Fallback DSN (used when ADMIN_DSN is not set)
# DATABASE_DSN=postgres://orbitjob:<YOUR_PASSWORD>@127.0.0.1:5432/orbitjob?sslmode=disable

# HTTP listen port (default: 8080)
# PORT=8080
