# Admin API environment configuration
# Copy to /opt/orbitjob/etc/admin-api.env and adjust values

# Deployment environment: production | staging | development
APP_ENV=production

# Database connection generated once for this OrbitJob installation.
# See docs/database-setup.md.
ADMIN_DSN=postgres://orbitjob_admin:<ADMIN_PASSWORD>@127.0.0.1:5432/orbitjob?sslmode=disable

# Legacy fallback only.
# DATABASE_DSN=

# HTTP listen port (default: 8080)
# PORT=8080

# External Console origin, including the port when non-default. Use HTTPS for
# production browser sessions. Proxy forwarding headers do not select this origin.
# CONSOLE_PUBLIC_ORIGIN=https://orbitjob.example.com

# Development only: permit browser sessions on an HTTP loopback origin.
# This does not allow HTTP sessions on a public hostname or a non-loopback IP.
# CONSOLE_ALLOW_INSECURE_LOCALHOST=false

# Optional namespace-to-tenant mapping for typed definition and retained-log
# routes. Helm injects the same operator.namespaceTenants mapping used by the
# Operator. Unset disables these additional routes; never infer it from CR labels.
# OPERATOR_NAMESPACE_TENANTS=

# Internal HTTPS archive URL; unset disables archive routes. Reader certificate,
# key and CA are mounted at /log-tls/reader.crt, reader.key and ca.crt by Helm.
# LOG_ARCHIVE_URL=https://orbitjob-log-archive.orbitjob-system.svc:8443

# Per-tenant token bucket rate limits, by endpoint group (requests/second).
# Each value sets both the refill rate and the burst size of the bucket.
# Groups: read (GET/HEAD), write (other non-trigger writes), trigger
# (/api/v1/jobs/:id/trigger and /api/v1/instances/:run_id/cancel).
# Code defaults when unset: read=100, write=10, trigger=5.
# The Helm chart overrides to read=100, write=100, trigger=10.
# Load tests require write >= 100 for prepare and trigger >= tuning output.
# RATELIMIT_READ_RPS=100
# RATELIMIT_WRITE_RPS=10
# RATELIMIT_TRIGGER_RPS=5
