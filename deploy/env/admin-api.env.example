# Admin API environment configuration
# Copy to /opt/orbitjob/etc/admin-api.env and adjust values

# Deployment environment: production | staging | development
APP_ENV=production

# Database connection generated once for this OrbitJob installation.
# See docs/database-setup.md.
ADMIN_DSN=postgres://orbitjob_admin:<ADMIN_PASSWORD>@127.0.0.1:5432/orbitjob?sslmode=disable

# Legacy fallback only.
# DATABASE_DSN=

# HTTP listen port (default: 8080)
# PORT=8080

# Per-tenant token bucket rate limits, by endpoint group (requests/second).
# Each value sets both the refill rate and the burst size of the bucket.
# Groups: read (GET/HEAD), write (other non-trigger writes), trigger
# (/api/v1/jobs/:id/trigger), admin (cancel operations).
# Code defaults when unset: read=100, write=10, trigger=5, admin=5.
# The Helm chart overrides to read=100, write=100, trigger=10, admin=10.
# Load tests require write >= 100 for prepare and trigger >= tuning output.
# RATELIMIT_READ_RPS=100
# RATELIMIT_WRITE_RPS=10
# RATELIMIT_TRIGGER_RPS=5
# RATELIMIT_ADMIN_RPS=5
