# Admin API environment configuration
# Copy to /opt/orbitjob/etc/admin-api.env and adjust values

# Deployment environment: production | staging | development
APP_ENV=production

# Database connection generated once for this OrbitJob installation.
# See docs/database-setup.md.
ADMIN_DSN=postgres://orbitjob_admin:<ADMIN_PASSWORD>@127.0.0.1:5432/orbitjob?sslmode=disable

# Legacy fallback only.
# DATABASE_DSN=

# HTTP listen port (default: 8080)
# PORT=8080
