# The supported archive is installed by Helm on one Linux node with a dedicated
# PVC. Values here mirror internal/logarchive defaults; chart values own Helm.
RUNTIME_DSN=postgres://orbitjob_runtime:<RUNTIME_PASSWORD>@postgres:5432/orbitjob?sslmode=disable
OPERATOR_NAMESPACE_TENANTS=default=00000000000000000000000001
LOG_DIRECTORY=/data
LOG_TOTAL_BYTES=7516192768
LOG_RUN_BYTES=33554432
LOG_HEAD_BYTES=8388608
LOG_WORKFLOW_BYTES=134217728
LOG_TENANT_BYTES=2147483648
LOG_DECLARED_BYTES=10737418240
LOG_RESERVE_BYTES=1073741824
# Kubernetes Downward API supplies POD_NAMESPACE and POD_NAME. The process
# verifies the exact data-<Pod name> PVC request; it needs at least 10 GiB.
# TLS mounts: /tls/ca.crt, server.crt and server.key. See the chart templates.
