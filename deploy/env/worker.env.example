# Worker environment configuration
# Copy to /opt/orbitjob/etc/worker.env and adjust values

# Deployment environment: production | staging | development
APP_ENV=production

# Shared runtime connection generated once for this installation.
# See docs/database-setup.md.
RUNTIME_DSN=postgres://orbitjob_runtime:<RUNTIME_PASSWORD>@127.0.0.1:5432/orbitjob?sslmode=disable

# Legacy component-specific fallback.
# WORKER_DSN=

# Unique worker identifier (auto-generated from hostname if not set)
# WORKER_ID=worker-01

# Tenant ID assigned to this worker. Empty means discover all active tenants.
# WORKER_TENANT_ID=default

# Interval between poll ticks in seconds (default: 2)
# WORKER_POLL_INTERVAL_SEC=2

# Interval between heartbeats in seconds (default: 10)
# WORKER_HEARTBEAT_INTERVAL_SEC=10

# Lease duration for claimed instances in seconds (default: 60)
# WORKER_LEASE_DURATION_SEC=60

# Maximum concurrent task executions (default: 5)
# WORKER_CAPACITY=5

# Adaptive capacity upper bound (default: 20)
# WORKER_CAPACITY_MAX=20

# Dynamic lease minimum duration in seconds (default: 10)
# WORKER_LEASE_MIN_SEC=10

# Dynamic lease maximum duration in seconds (default: 300)
# WORKER_LEASE_DURATION_MAX=300

# Dynamic lease EMA decay coefficient, must be in (0, 1] (default: 0.1)
# WORKER_LEASE_EMA_DECAY=0.1

# Labels as JSON object, e.g. '{"zone":"us-east-1","pool":"general"}'
# WORKER_LABELS={}

# Health check HTTP port (default: 6062)
# Endpoints: /healthz, /readyz
WORKER_HEALTH_PORT=6062

# Container execution (Kubernetes Job-per-task). Enable with true when the
# worker runs in-cluster with a task namespace.
# WORKER_CONTAINER_ENABLED=false

# Task namespace for container execution.
# WORKER_CONTAINER_NAMESPACE=orbitjob-tasks

# Task namespace poll interval in milliseconds (default: 1000).
# WORKER_CONTAINER_POLL_INTERVAL_MS=1000

# Static pool sizing when adaptive capacity is disabled (default: true).
# capacity 14 / max 14 matches the kind loadtest resource model:
# quota limits.cpu=10 / task limit 500m = 20 pods ceiling; never raise
# WORKER_CAPACITY_MAX above the task namespace quota.
# WORKER_ADAPTIVE_CAPACITY_ENABLED=true

# etcd coordination endpoints (build tag etcd). Comma-separated.
# ETCD_ENDPOINTS=127.0.0.1:2379
