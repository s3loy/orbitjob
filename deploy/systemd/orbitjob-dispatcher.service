[Unit]
Description=OrbitJob Dispatcher
Documentation=https://github.com/orbitjob/orbitjob
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=orbitjob
Group=orbitjob
EnvironmentFile=/opt/orbitjob/etc/dispatcher.env
ExecStart=/opt/orbitjob/current/dispatcher
Restart=always
RestartSec=5

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/orbitjob/var/log
PrivateTmp=yes

# Resource limits
MemoryMax=256M
CPUQuota=100%

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=orbitjob-dispatcher

[Install]
WantedBy=multi-user.target
