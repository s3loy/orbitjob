[Unit]
Description=OrbitJob Worker
Documentation=https://github.com/orbitjob/orbitjob
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=orbitjob
Group=orbitjob
EnvironmentFile=/opt/orbitjob/etc/worker.env
ExecStart=/opt/orbitjob/current/worker
Restart=always
RestartSec=5

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/orbitjob/var/log
PrivateTmp=yes

# Resource limits
MemoryMax=512M
CPUQuota=200%

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=orbitjob-worker

[Install]
WantedBy=multi-user.target
