[Unit]
Description=OrbitJob Admin API
Documentation=https://github.com/orbitjob/orbitjob
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=orbitjob
Group=orbitjob
EnvironmentFile=/opt/orbitjob/etc/admin-api.env
ExecStart=/opt/orbitjob/current/admin-api
Restart=always
RestartSec=5

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/orbitjob/var/log
PrivateTmp=yes

# Resource limits
MemoryMax=256M
CPUQuota=50%

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=orbitjob-admin-api

[Install]
WantedBy=multi-user.target
